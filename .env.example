# Moralis Web3 Data API - free key at https://moralis.com (Admin > API Keys)
MORALIS_API_KEY=your-moralis-api-key

# X (Twitter) Developer App credentials - app must have Read and Write permissions
X_CONSUMER_KEY=your-consumer-key
X_CONSUMER_SECRET=your-consumer-secret
X_ACCESS_TOKEN=your-access-token
X_ACCESS_SECRET=your-access-secret

# Dashboard
ADMIN_PASSWORD=change-me
PORT=3000

# Optional
# 600s keeps API usage inside the Moralis free tier (5 marketplaces are polled per cycle)
POLL_INTERVAL_SECONDS=600
# DB_PATH=./data/bot.db
# Initial mode on first run only - afterwards use the Dry run / Live toggle in the dashboard
# DRY_RUN=true
